{
  "name": "blumendorf-website-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:profile": "mkdir -p public/api/v1 && cp src/lib/data/profile.json public/api/v1/profile.json",
    "dev": "pnpm sync:profile && vite",
    "build": "pnpm sync:profile && tsc -b && vite build",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "pnpm lint --fix",
    "preview": "vite preview",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update-snapshots": "playwright test e2e/visual-regression.spec.ts --update-snapshots --project=chromium"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.1",
    "@mlc-ai/web-llm": "^0.2.80",
    "lucide-react": "^0.563.0",
    "motion": "^12.29.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-ga4": "^2.1.0",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "homepage": "https://blumendorf.github.io/profile-page/"
}