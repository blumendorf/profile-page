{
  "name": "profile-page",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.1",
  "type": "module",
  "scripts": {
    "sync:profile": "mkdir -p public/api/v1 && cp src/lib/data/profile.json public/api/v1/profile.json",
    "dev": "pnpm sync:profile && vite",
    "build": "pnpm sync:profile && tsc -b && vite build && pnpm build:storybook",
    "build:storybook": "storybook build -o dist/storybook",
    "storybook": "storybook dev -p 6006",
    "lint": "tsc --noEmit && eslint .",
    "lint:design": "npx @google/design.md lint DESIGN.md",
    "lint:fix": "pnpm lint --fix",
    "preview": "vite preview",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update-snapshots": "playwright test e2e/visual-regression.spec.ts --update-snapshots --project=chromium"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mlc-ai/web-llm": "0.2.82",
    "lucide-react": "1.8.0",
    "motion": "12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-ga4": "3.0.1",
    "react-router-dom": "7.14.2",
    "react-syntax-highlighter": "16.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/gtag.js": "0.0.20",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "jsdom": "29.0.2",
    "postcss": "8.5.10",
    "storybook": "10.3.5",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.9",
    "vitest": "4.1.5"
  },
  "homepage": "https://blumendorf.github.io/"
}