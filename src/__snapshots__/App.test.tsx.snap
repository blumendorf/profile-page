exports[`App > DOM Snapshots > hero section structure 1`] = `"<div class="w-full max-w-4xl mx-auto py-20"><div class="flex flex-col md:flex-row items-center gap-12 md:gap-16"><div class="relative shrink-0" style="opacity: 0; transform: scale(0.9);"><div class="absolute -inset-3 rounded-full" style="--ring-angle: 0deg;"><div class="absolute inset-0 rounded-full animate-spin-slow" style="background: conic-gradient(from 0deg, transparent, var(--accent-primary), transparent); animation-duration: 8s;"></div><div class="absolute inset-[2px] rounded-full bg-page"></div></div><div class="relative w-40 h-40 sm:w-48 sm:h-48 rounded-full overflow-hidden border-2 border-border-subtle pointer-events-none"><img alt="Portrait photo of Dr Marco Blumendorf" class="w-full h-full object-cover object-center" src="/marco-small.jpg"></div></div><div class="text-center md:text-left" style="opacity: 0; transform: translateY(20px);"><h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight mb-4">Dr Marco Blumendorf</h1><p class="text-xl sm:text-2xl text-accent font-mono font-medium mb-6">Director of Software Engineering</p><p class="text-body max-w-lg mb-8 text-balance">I spent a decade at TU Berlin researching adaptive UIs and distributed AI. Now I lead engineering teams, rethinking how we build software alongside AI.</p><div class="flex flex-wrap gap-2 justify-center md:justify-start mb-8"><span class="badge">Engineering</span><span class="badge">Leadership</span><span class="badge">AI first</span></div><button class="btn-primary" aria-label="Scroll to learn more"><span>Learn more</span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></button></div></div></div><div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-muted" style="opacity: 0;"><div class="w-px h-12 bg-linear-to-b from-border-active to-transparent"></div></div><div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(to right, transparent, var(--border-subtle), transparent);"></div>"`;

exports[`App > DOM Snapshots > navigation structure 1`] = `"<div class="max-w-4xl mx-auto px-6 sm:px-8"><div class="flex items-center justify-between"><a href="#home" class="font-mono font-semibold text-base sm:text-lg truncate max-w-[200px] sm:max-w-none text-text-primary hover:text-accent transition-all duration-300 opacity-100 translate-x-0" tabindex="0" aria-hidden="false">Dr Marco Blumendorf<span class="text-accent">.</span></a><div class="hidden lg:flex items-center gap-1" aria-label="Desktop navigation"><a href="#about" class="px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors text-text-muted hover:text-text-primary">About</a><a href="#expertise" class="px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors text-text-muted hover:text-text-primary">Expertise</a><a href="#tech-stack" class="px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors text-text-muted hover:text-text-primary">Tech Stack</a><a href="#journey" class="px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors text-text-muted hover:text-text-primary">Journey</a><a href="#lab" class="px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors text-text-muted hover:text-text-primary">Lab</a><a href="#contact" class="px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors text-accent" aria-current="page">Contact</a><div class="w-px h-4 bg-border-subtle mx-2"></div><button class="px-2 py-1 text-xs font-mono font-bold rounded border transition-colors bg-transparent text-text-muted border-text-muted hover:text-text-primary hover:border-text-primary" aria-label="Switch to JSON view">JSON</button></div><div class="flex items-center gap-2 lg:hidden"><button class="px-2 py-1 text-xs font-mono font-bold rounded border transition-colors bg-transparent text-text-muted border-text-muted">JSON</button><button class="p-2 text-text-muted hover:text-text-primary rounded-md transition-colors" aria-label="Toggle mobile menu"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></div></div>"`;

exports[`App > DOM Snapshots > tech-stack section structure 1`] = `"<div class="section-container" style="opacity: 0;"><span class="section-label block" style="opacity: 0;">// tech stack</span><h2 id="tech-stack-heading" class="heading-lg mb-4" style="opacity: 0;">Technical Foundation</h2><p class="text-muted mb-10" style="opacity: 0;">Tools I work with daily.</p><div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"><div style="opacity: 0;"><h3 class="text-xs font-mono font-medium text-accent uppercase tracking-wider mb-3">Frontend</h3><div class="flex flex-wrap gap-2"><span class="badge">React</span><span class="badge">TypeScript</span><span class="badge">Vite</span><span class="badge">Tailwind CSS</span><span class="badge">TanStack Query</span></div></div><div style="opacity: 0;"><h3 class="text-xs font-mono font-medium text-accent uppercase tracking-wider mb-3">Backend</h3><div class="flex flex-wrap gap-2"><span class="badge">Python</span><span class="badge">Firebase Functions</span><span class="badge">Pydantic</span><span class="badge">GCP Cloud Functions</span></div></div><div style="opacity: 0;"><h3 class="text-xs font-mono font-medium text-accent uppercase tracking-wider mb-3">Data &amp; Search</h3><div class="flex flex-wrap gap-2"><span class="badge">Firestore</span><span class="badge">BigQuery</span><span class="badge">Typesense</span><span class="badge">Elasticsearch</span><span class="badge">PostgreSQL</span></div></div><div style="opacity: 0;"><h3 class="text-xs font-mono font-medium text-accent uppercase tracking-wider mb-3">AI &amp; ML</h3><div class="flex flex-wrap gap-2"><span class="badge">OpenAI</span><span class="badge">Anthropic Claude</span><span class="badge">LangChain</span><span class="badge">Cohere</span><span class="badge">Google GenAI</span></div></div><div style="opacity: 0;"><h3 class="text-xs font-mono font-medium text-accent uppercase tracking-wider mb-3">Infrastructure</h3><div class="flex flex-wrap gap-2"><span class="badge">GCP</span><span class="badge">Terraform</span><span class="badge">Cloud Tasks</span><span class="badge">Pub/Sub</span><span class="badge">Firebase Auth</span></div></div><div style="opacity: 0;"><h3 class="text-xs font-mono font-medium text-accent uppercase tracking-wider mb-3">Practices</h3><div class="flex flex-wrap gap-2"><span class="badge">Vitest</span><span class="badge">Playwright</span><span class="badge">Cypress</span><span class="badge">CI/CD</span><span class="badge">Feature Flags</span></div></div></div></div>"`;
